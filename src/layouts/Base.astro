---
// The frame every page sits in: the bar, the page, the footer. The home page
// passes `home` so the body fits one screen and the footer stays off.
import site from '../data/site.json';
import '../styles/site.css';

interface Props {
	title: string;
	description: string;
	home?: boolean;
}
const { title, description, home = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/unit', label: 'Unit' },
	{ href: '/roles', label: 'Roles' },
	{ href: '/roster', label: 'Roster' },
	{ href: '/sop', label: 'SOP' },
	{ href: '/quiver', label: 'Quiver' },
	{ href: '/smartcards', label: 'SmartCards' },
	{ href: '/events', label: 'Events' },
	{ href: '/tbd', label: 'To be decided' },
];
const join = site.discord !== '' ? site.discord : `${site.pac}/?page=apply`;
const joinLabel = site.discord !== '' ? 'Join Discord' : 'Join us';
const fullTitle = title === site.short ? `${site.short} - ${site.name}` : `${title} - ${site.short}`;
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<title>{fullTitle}</title>
	<meta name="description" content={description}>
	<meta property="og:title" content={fullTitle}>
	<meta property="og:description" content={description}>
	<meta property="og:site_name" content={site.name}>
	<meta property="og:type" content="website">
	<meta property="og:image" content={new URL('/og.png', Astro.site)}>
	<meta name="twitter:card" content="summary_large_image">
	<link rel="icon" href="/favicon.png">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
	<link rel="canonical" href={new URL(path === '/' ? '/' : path, Astro.site)}>
	<script is:inline>
		// Light or dark before the first paint: the saved choice, else dark (the site's own look).
		(function () {
			var t = null;
			try { t = localStorage.getItem('theme'); } catch (e) {}
			if (t !== 'light' && t !== 'dark') t = 'dark';
			document.documentElement.setAttribute('data-theme', t);
		})();
	</script>
</head>
<body class:list={{ home }}>
	<header class="bar">
		<a class="brand" href="/"><img src="/logo.svg" alt="" width="36" height="36">{site.short}</a>
		<button class="theme" type="button" id="theme" aria-label="Switch between light and dark" title="Light / dark"><span class="sun"></span><span class="moon"></span></button>
		<button class="navtoggle" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
		<nav class="nav" id="nav" aria-label="Site">
			{links.map((l) => (
				<a href={l.href} aria-current={!l.external && l.href === path ? 'page' : undefined}
				   target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a>
			))}
			<a class="btn ghost small" href={`${site.pac}/`} target="_blank" rel="noopener">TAC//PAC</a>
			<a class="btn small" href={join} target={site.discord !== '' ? '_blank' : undefined} rel="noopener">{joinLabel}</a>
		</nav>
	</header>
	<main>
		<slot />
	</main>
	<a class="totop" href="#" id="totop" aria-label="Back to top" hidden><span>Top</span></a>
	{!home && (
		<footer>
			<a class="brand" href="/"><img src="/logo.svg" alt="" width="28" height="28">{site.short}</a>
			<nav aria-label="Footer">
				{links.map((l) => <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a>)}
				<a href={`${site.pac}/`} target="_blank" rel="noopener">TAC//PAC</a>
			</nav>
			<span class="copy">&copy; {new Date().getFullYear()} {site.short}</span>
		</footer>
	)}
	<script>
		// Back to top, once a long page has been scrolled a screen and a half.
		const top = document.getElementById('totop');
		const showTop = () => { top.hidden = window.scrollY < window.innerHeight * 1.5; };
		window.addEventListener('scroll', showTop, { passive: true }); showTop();
		top.addEventListener('click', (e) => { e.preventDefault(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
		// Light / dark: the button flips it and remembers it on this device.
		const th = document.getElementById('theme');
		th?.addEventListener('click', () => {
			const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
			document.documentElement.setAttribute('data-theme', next);
			try { localStorage.setItem('theme', next); } catch (e) {}
		});
		const t = document.querySelector('.navtoggle');
		const n = document.getElementById('nav');
		if (t && n) {
			t.addEventListener('click', () => {
				const open = n.classList.toggle('open');
				t.setAttribute('aria-expanded', open ? 'true' : 'false');
			});
		}
	</script>
</body>
</html>
