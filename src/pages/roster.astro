---
// The roster: staff first, then everyone else, with the whole of what TAC//PAC
// shows the public - rank, qualifications, status, when they enlisted - written
// out in words (user, 2026-10-08: "more details less acronyms and
// abbreviations"; "break in to staff ... then an unlabelled section with
// everyone else"). Nobody is assigned to a slot yet, so a slot line shows only
// when there is one.
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="Roster" description={`Who serves in Alpha Company, ${site.short}: rank, qualifications and status, live from TAC//PAC.`}>
	<div class="wrap pagehead">
		<p class="eyebrow">Alpha Company · {site.short}</p>
		<h1>The roster</h1>
		<p class="lede">Everyone on the books, as TAC//PAC holds them right now: rank, what they are qualified to do, and when they enlisted. Early days: the structure in TAC//PAC is still being tested, and nobody is assigned to a slot yet.</p>
	</div>
	<section class="section">
		<div class="wrap" id="roster">
			<p class="dim">Loading the roster from TAC//PAC. If it does not appear, it is on <a href={`${site.pac}/`} target="_blank" rel="noopener">TAC//PAC</a>.</p>
		</div>
	</section>

	<script>
		import { feed, esc, expand, skillName, words, PAC } from '../scripts/pac.js';
		const box = document.getElementById('roster');

		const month = (iso) => {
			const d = new Date(iso + 'T00:00:00');
			return Number.isNaN(d.getTime()) ? '' : new Intl.DateTimeFormat(undefined, { month: 'long', year: 'numeric' }).format(d);
		};

		/* Qualifications in groups, not one long line (user, 2026-10-08:
		   "should be more structured and less of a csv list"). */
		const CATS = [
			['Medical', ['cls', 'medic']],
			['Engineering and breaching', ['eng', 'breacher']],
			['Fires and reconnaissance', ['jfo', 'isr', 'uav']],
			['Marksmanship', ['marksman', 'sniper']],
		];
		const quals = (r, p) => {
			const left = new Set(p.skills);
			const groups = [];
			for (const [label, ids] of CATS) {
				const have = ids.filter((id) => left.has(id));
				if (!have.length) continue;
				have.forEach((id) => left.delete(id));
				groups.push([label, have]);
			}
			if (left.size) groups.push(['Other', [...left]]);
			return groups.map(([label, ids]) => `<div class="qcat"><span class="qlabel">${esc(label)}</span><span class="qitems">${ids.map((id) => `<i>${esc(skillName(r.skills[id], id))}</i>`).join('')}</span></div>`).join('');
		};

		const card = (r, p) => {
			const rank = r.ranks[p.rank];
			const ins = rank && rank.insignia ? `<img src="${esc(rank.insignia)}" alt="">` : '';
			const q = quals(r, p);
			const awards = p.awards.map((a) => esc(r.awards[a]?.name || a)).filter(Boolean);
			const slot = p.role && r.roles[p.role]
				? esc(words(r.roles[p.role])) + (p.group ? `, ${esc(expand(p.group))}` : '')
				: (p.group ? esc(expand(p.group)) : '');
			const rows = [
				['Rank', rank ? esc(rank.name) + (rank.payGrade ? ` <span class="muted mono">${esc(rank.payGrade)}</span>` : '') : ''],
				['Slot', slot],
				['Qualified as', q ? `<div class="quals">${q}</div>` : ''],
				['Awards', awards.length ? awards.join(', ') : ''],
				['Status', p.status ? esc(r.statuses[p.status] || p.status) : ''],
				['Enlisted', month(p.enlisted)],
			].filter(([, v]) => v !== '');
			return `<article class="rs-card">
				<div class="rs-ins">${ins}</div>
				<div class="rs-body">
					<h3>${esc(p.name)}</h3>
					<dl>${rows.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('')}</dl>
				</div>
			</article>`;
		};

		feed('roster').then((r) => {
			if (!r.players.length) { box.innerHTML = '<p class="dim">The roster is being set up.</p>'; return; }
			const staff = r.players.filter((p) => p.staff);
			const rest = r.players.filter((p) => !p.staff);
			let out = '';
			if (staff.length) out += `<div class="rs-group"><h2>Staff</h2><div class="rs-people">${staff.map((p) => card(r, p)).join('')}</div></div>`;
			out += rest.length
				? `<div class="rs-group"><div class="rs-people">${rest.map((p) => card(r, p)).join('')}</div></div>`
				: '<div class="rs-group"><p class="dim">The rest of the company goes here as people enlist.</p></div>';
			box.innerHTML = out;
		}).catch(() => {
			box.innerHTML = `<p class="dim">The roster could not be read right now. It is on <a href="${esc(PAC)}/" target="_blank" rel="noopener">TAC//PAC</a>.</p>`;
		});
	</script>
</Base>
